
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF
}

enum OrderStatus {
  RECEIVED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum OrderType {
  DELIVERY
  PICKUP
  DINE_IN
}

enum PaymentMethod {
  CASH
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  phone        String?
  password     String
  role         UserRole      @default(CUSTOMER)
  orders       Order[]
  reservations Reservation[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model MenuItem {
  id          String      @id @default(cuid())
  name        String
  description String
  category    String
  price       Float
  image       String
  rating      String      @default("4.5")
  available   Boolean     @default(true)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  customerName  String
  phone         String
  address       String?
  orderType     OrderType
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  total         Float
  status        OrderStatus @default(RECEIVED)
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id         String   @id @default(cuid())
  quantity   Int
  price      Float
  orderId    String
  menuItemId String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
}

model Reservation {
  id             String            @id @default(cuid())
  name           String
  phone          String
  date           DateTime
  time           String
  guests         Int
  seating        String
  specialRequest String?
  status         ReservationStatus @default(PENDING)
  userId         String?
  user           User?             @relation(fields: [userId], references: [id])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}
